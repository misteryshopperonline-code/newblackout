# Public canonical origin of this Next.js deployment (no trailing slash).
NEXT_PUBLIC_APP_URL=http://localhost:3000
# Existing marketing site, used for navigation back to solutions and blog.
NEXT_PUBLIC_MARKETING_URL=https://blackout.com.ec

# Direct email mode: verified Resend sender, server-only values.
RESEND_API_KEY=
RESEND_FROM_EMAIL=
RESEND_REPLY_TO=info@blackout.com.ec
QUOTE_NOTIFICATION_EMAIL=

# Optional: complete HTTPS URL of your EXISTING Netlify send-quote function.
# When set, this mode uses its existing PDF, email and CRM instead of direct Resend.
# Example: https://YOUR-SITE.netlify.app/.netlify/functions/send-quote
QUOTE_SERVICE_URL=
